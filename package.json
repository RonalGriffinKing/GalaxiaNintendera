{
  "name": "galaxia-nintendera",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap": "node scripts/run-capacitor.cjs",
    "android:add": "npm run build && npm run cap -- add android",
    "android:assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-android-assets.ps1",
    "android:sync": "npm run build && npm run cap -- sync android",
    "android:open": "npm run cap -- open android",
    "android:apk": "npm run android:sync && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "firebase": "^12.12.1",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "socket.io-client": "^4.8.3",
    "tmi.js": "^1.8.5",
    "vue": "^3.5.32",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/vue3-vite": "^10.4.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10",
    "vitest": "^4.1.6"
  }
}
