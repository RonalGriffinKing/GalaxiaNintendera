rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function adminUid() { return 'vOWD2r82tSgrSqHL8PUfCkPcrhG2'; }
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() {
      return signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().get('isBlocked', true) == false
        && profile().get('deleted', false) == false;
    }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function member(data) { return signedIn() && data.get('participants', []) is list && request.auth.uid in data.get('participants', []); }
    function ownMap(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || (request.resource.data.get(field, {}) is map
          && request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([request.auth.uid]));
    }
    function ownText(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || request.resource.data.get(field, {}).get(request.auth.uid, '') is string;
    }
    function ownFlag(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || request.resource.data.get(field, {}).get(request.auth.uid, false) is bool;
    }
    function ownTime(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || (request.resource.data.get(field, {}).get(request.auth.uid, 0) is int
          && request.resource.data.get(field, {}).get(request.auth.uid, 0) >= 0);
    }
    function chatMember(chatId) {
      return active() && exists(/databases/$(database)/documents/directChats/$(chatId))
        && member(get(/databases/$(database)/documents/directChats/$(chatId)).data);
    }
    function chatEnabled() {
      return active() && ((adminUid() != '' && request.auth.uid == adminUid())
        || profile().get('editorialPublisher', false) == true || profile().get('canChat', false) == true);
    }
    match /users/{uid} {
      allow get: if self(uid);
      allow list, create, delete: if false;
      // Personal presence only. Roles, publisher capability, economy and profile edits use the verified backend.
      allow update: if self(uid) && active() && changedOnly(['isOnline','lastActiveAt','updatedAt'])
        && request.resource.data.get('isOnline', false) is bool
        && request.resource.data.get('lastActiveAt', 0) is int
        && request.resource.data.get('lastActiveAt', 0) >= 0
        && request.resource.data.get('lastActiveAt', 0) <= request.time.toMillis() + 60000;
      match /favorites/{postId} {
        allow read, delete: if self(uid);
        allow create, update: if self(uid) && active()
          && request.resource.data.keys().hasOnly(['postId','postSlug','title','image','category','authorName','createdAt','savedAt'])
          && request.resource.data.postId == postId
          && request.resource.data.get('savedAt', 0) is int && request.resource.data.get('savedAt', 0) >= 0
          && request.resource.data.title is string && request.resource.data.title.size() <= 240;
      }
      match /notifications/{id} {
        allow read, delete: if self(uid);
        allow create: if false;
        allow update: if self(uid) && changedOnly(['read']) && request.resource.data.read == true;
      }
      match /readPosts/{id} { allow read: if self(uid); allow write: if false; }
      match /followers/{id} { allow read: if self(uid); allow write: if false; }
      match /following/{id} { allow read: if self(uid); allow write: if false; }
      match /communities/{id} { allow read: if self(uid); allow write: if false; }
      match /socialTemplates/{id} { allow read: if self(uid); allow write: if self(uid) && active(); }
    }
    match /directChats/{chatId} {
      allow read: if active() && member(resource.data);
      allow create, delete: if false;
      allow update: if active() && member(resource.data)
        && changedOnly(['lastReadBy','hiddenBefore','pinnedBy','clearedAtBy','deletedFor','updatedAt'])
        && ownMap('lastReadBy') && ownText('lastReadBy')
        && ownMap('hiddenBefore') && ownTime('hiddenBefore')
        && ownMap('clearedAtBy') && ownTime('clearedAtBy')
        && ownMap('pinnedBy') && ownFlag('pinnedBy')
        && ownMap('deletedFor') && ownFlag('deletedFor');
      match /messages/{messageId} {
        allow read: if chatMember(chatId);
        allow create, delete: if false;
        allow update: if chatMember(chatId) && changedOnly(['readBy','seenAt'])
          && ownMap('readBy') && ownMap('seenAt')
          && request.resource.data.get('readBy', {}).get(request.auth.uid, false) == true
          && request.resource.data.get('seenAt', {}).get(request.auth.uid, request.time) is timestamp;
      }
    }
    match /liveChats/{channel} {
      allow read: if chatEnabled();
      allow write: if false;
      match /messages/{messageId} { allow read: if chatEnabled(); allow write: if false; }
    }
    // Originals and mixed historical documents are never public SDK reads.
    // Netlify serves closed public DTOs and verifies every privileged write.
    match /posts/{id} { allow read, write: if false; }
    match /publicNews/{id} { allow read, write: if false; }
    match /publicProfiles/{id} { allow read, write: if false; }
    match /sitePages/{id} { allow read, write: if false; }
    match /siteSettings/{id} { allow read, write: if false; }
    match /siteConfig/{id} { allow read, write: if false; }
    match /profileIcons/{id} { allow read, write: if false; }
    match /publicEditorialSettings/{id} { allow read, write: if false; }
    match /editorialRequests/{id} { allow read, write: if false; }
    match /editorialSlugs/{id} { allow read, write: if false; }
    match /editorialPublication/{id} { allow read, write: if false; }
    match /communities/{id} { allow read, write: if false; match /members/{uid} { allow read, write: if false; } }
    match /communityThreads/{id} { allow read, write: if false; }
    match /galaxyEvents/{id} { allow read, write: if false; }
    match /liveGoals/{id} { allow read, write: if false; }
    match /videoChats/{id} { allow read, write: if false; match /messages/{mid} { allow read, write: if false; } }
    // The existing private overlay editor remains scoped to its owner; no anonymous JSON exposure.
    match /overlays/{uid}/items/{id} { allow read: if self(uid); allow write: if self(uid) && active(); }
    // Existing printer data: explicit owner UID, no economy or global administrative bypass.
    match /ruzafaPrinterProducts/{id} { allow read, write: if active() && adminUid() != '' && request.auth.uid == adminUid(); }
    match /ruzafaPrinterHistory/{id} { allow read, write: if active() && adminUid() != '' && request.auth.uid == adminUid(); }
    match /{path=**} { allow read, write: if false; }
  }
}
