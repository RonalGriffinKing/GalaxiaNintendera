// FRAGMENT ONLY: insert inside match /databases/{database}/documents.
// No deployment configuration points at this file. Existing production allows
// for users/profileIcons/siteConfig must be REPLACED or combined with these
// guards. A broad allow elsewhere will bypass them. Preserve unrelated rules.
function progressAdmin() {
  return request.auth != null && request.auth.uid in ['vOWD2r82tSgrSqHL8PUfCkPcrhG2'];
}
function progressSafeProfileCreate() {
  let d = request.resource.data;
  return d.get('stars', 0) == 0
    && d.get('participationStars', 0) == 0
    && d.get('readPostsCount', 0) == 0
    && d.get('unlockedIcons', ['kirby-01']) == ['kirby-01']
    && d.get('selectedIcon', 'kirby-01') == 'kirby-01'
    && d.get('selectedIconUrl', '') == ''
    && d.get('selectedIconEffect', {}) == {}
    && d.get('progressVersion', 0) == 0
    && d.get('progressMigrationVersion', 0) == 0
    && ((d.get('role', 'user') == 'user'
      && d.get('isBlocked', false) == false && d.get('canChat', false) == false) || progressAdmin());
}
function progressSafeProfileUpdate() {
  let changed = request.resource.data.diff(resource.data).affectedKeys();
  return !changed.hasAny(['stars','participationStars','readPostsCount',
      'unlockedIcons','selectedIcon','selectedIconUrl','selectedIconEffect',
      'progressVersion','progressMigrationVersion'])
    && (progressAdmin() || !changed.hasAny(['role','isBlocked','canChat']));
}
// In the EXISTING users/{uid} match, combine your current permission with:
// allow create: if (EXISTING_CREATE_PERMISSION) && progressSafeProfileCreate();
// allow update: if (EXISTING_UPDATE_PERMISSION) && progressSafeProfileUpdate();
// allow delete: if progressAdmin() && (EXISTING_DELETE_PERMISSION);
// Keep existing profile reads and permitted presentation fields unchanged.
match /users/{uid}/readPosts/{postId} {
  // Retain the current read policy. This fragment adds no read permissions.
  allow write: if false; // Admin SDK only, including deletes.
}
match /users/{uid}/readingSessions/{postId} {
  allow read, write: if false; // Server-owned elapsed-time proof.
}
match /profileIcons/{iconId} {
  allow read: if true; // Public catalog metadata; hidden does not mean secret.
  allow write: if false; // Verified function also preserves acquired rights.
}
match /siteConfig/profileAchievements {
  allow read: if true;
  allow write: if false; // Global Manager -> verified function.
}
