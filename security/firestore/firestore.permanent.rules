// LOCAL CANDIDATE ONLY. UID confirmed by the owner, 2026-11-08.
// Never combine with the former global timed allow. No deployment is configured.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { return isSignedIn() && request.auth.uid in ['vOWD2r82tSgrSqHL8PUfCkPcrhG2']; }
    // No additional publishers have been authorized. Firestore role fields grant nothing.
    function isPublisher() { return isAdmin() || (isSignedIn() && request.auth.uid in []); }
    function isActive() { return isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBlocked', false) == false); }
    function chatAllowed() { return isActive() && (isPublisher() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('canChat', false) == true); }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function text(value, max) { return value is string && value.size() <= max; }
    function publicPost(data) {
      let release = data.get('releaseAt',data.get('scheduledAt',0));
      return data.get('status','') == 'approved' && data.get('visibility','public') in ['public','unlisted']
        && ((release is number && release <= request.time.toMillis()) || (release is timestamp && release <= request.time));
    }
    function ownToggle(before, after) {
      return before is list && after is list && after.size() == after.toSet().size()
        && (before == after || (!(request.auth.uid in before) && after.toSet() == before.toSet().union([request.auth.uid].toSet()))
        || (request.auth.uid in before && after.toSet() == before.toSet().difference([request.auth.uid].toSet())));
    }
    function ownMap(key) { return request.resource.data.get(key,{}) is map && request.resource.data.get(key,{}).diff(resource.data.get(key,{})).affectedKeys().hasOnly([request.auth.uid]); }
    function ownReplyChange(before, after) {
      let removed = before.removeAll(after);
      let added = after.removeAll(before);
      return after is list && after.size() <= 200 && removed.size() <= 1 && added.size() <= 1
        && (removed.size() == 0 || removed[0].authorId == request.auth.uid)
        && (added.size() == 0 || (added[0].authorId == request.auth.uid && text(added[0].body,2000) && added[0].body.size() > 0))
        && (removed.size() == 0 || added.size() == 0 || added[0].id == removed[0].id);
    }
    match /users/{uid} {
      function initialProgress() {
        let d = request.resource.data;
        return d.get('stars',0) == 0 && d.get('participationStars',0) == 0 && d.get('readPostsCount',0) == 0
          && d.get('unlockedIcons',['kirby-01']) == ['kirby-01'] && d.get('selectedIcon','kirby-01') == 'kirby-01'
          && d.get('selectedIconUrl','') == '' && d.get('selectedIconEffect',{}) == {}
          && d.get('progressVersion',0) == 0 && d.get('progressMigrationVersion',0) == 0;
      }
      function progressUnchanged() { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stars','participationStars','readPostsCount','unlockedIcons','selectedIcon','selectedIconUrl','selectedIconEffect','progressVersion','progressMigrationVersion']); }
      allow read: if isOwner(uid) || isAdmin();
      allow create: if initialProgress() && (isAdmin() || (isOwner(uid)
        && request.resource.data.keys().hasOnly(['name','email','description','imageUrl','provider','emailVerified','emailVerificationRequired','emailOptIn','legalAccepted','legalAcceptedAt','legalVersion','parentalConsentConfirmed','role','stars','readPostsCount','unlockedIcons','selectedIcon','selectedIconUrl','createdAt','updatedAt'])
        && request.resource.data.get('role','user') == 'user'
        && request.resource.data.get('email','') == request.auth.token.get('email','')
        && request.resource.data.get('emailVerified',false) == request.auth.token.get('email_verified',false)
        && text(request.resource.data.get('name',''),120)));
      allow update: if progressUnchanged() && (isAdmin() || (isOwner(uid) && isActive()
        && changedOnly(['name','description','imageUrl','email','provider','emailVerified','emailOptIn','socialLinks','legalAccepted','legalAcceptedAt','legalVersion','parentalConsentConfirmed','isOnline','lastActiveAt','updatedAt'])
        && text(request.resource.data.get('name',''),120) && text(request.resource.data.get('description',''),2000)
        && request.resource.data.get('email','') == request.auth.token.get('email','')
        && request.resource.data.get('emailVerified',false) == request.auth.token.get('email_verified',false)));
      allow delete: if isAdmin();
      match /readPosts/{post} { allow read: if isOwner(uid) || isAdmin(); allow write: if false; }
      match /readingSessions/{post} { allow read, write: if false; }
      match /favorites/{post} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) && isActive() && request.resource.data.keys().hasOnly(['postId','postSlug','title','image','category','authorName','createdAt','savedAt']) && request.resource.data.postId == post && publicPost(get(/databases/$(database)/documents/posts/$(post)).data);
        allow delete: if isOwner(uid) || isAdmin();
      }
      match /socialTemplates/{template} { allow read, write: if isOwner(uid) && isPublisher(); }
      match /communities/{community} {
        allow read: if true; // Explicitly displayed public memberships; no private user fields.
        allow create, update: if isAdmin() || (isOwner(uid) && isActive() && community != 'galaxia-oficial'
          && !get(/databases/$(database)/documents/communities/$(community)).data.get('lockedMembership',false)
          && request.resource.data.keys().hasOnly(['communityId','name','description','bannerUrl','iconUrl','role','joinedAt','updatedAt'])
          && request.resource.data.communityId == community && request.resource.data.role == 'Miembro');
        allow delete: if isAdmin() || (isOwner(uid) && community != 'galaxia-oficial');
      }
      match /followers/{actor} {
        allow read: if true;
        allow create, update: if isOwner(actor) && isActive() && actor != uid && exists(/databases/$(database)/documents/users/$(uid))
          && request.resource.data.keys().hasOnly(['userId','name','imageUrl','followedAt','createdAt']) && request.resource.data.userId == actor;
        allow delete: if isOwner(actor) || isAdmin();
      }
      match /following/{target} {
        allow read: if true;
        allow create, update: if isOwner(uid) && isActive() && target != uid && exists(/databases/$(database)/documents/users/$(target))
          && request.resource.data.keys().hasOnly(['userId','name','imageUrl','followedAt','createdAt']) && request.resource.data.userId == target;
        allow delete: if isOwner(uid) || isAdmin();
      }
      match /notifications/{notification} {
        function validEvent() {
          let d=request.resource.data;
          return (d.type == 'new-follower' && d.targetId == request.auth.uid && exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)))
            || (d.type == 'thread-like' && get(/databases/$(database)/documents/communityThreads/$(d.targetId)).data.authorId == uid && request.auth.uid in get(/databases/$(database)/documents/communityThreads/$(d.targetId)).data.get('likedBy',[]))
            || (d.type == 'thread-reply' && d.comment.authorId == request.auth.uid && get(/databases/$(database)/documents/communityThreads/$(d.targetId)).data.authorId == uid && get(/databases/$(database)/documents/communityThreads/$(d.targetId)).data.get('comments',[]).hasAny([d.comment]));
        }
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isAdmin() || (isActive() && request.resource.data.keys().hasOnly(['type','title','message','actorId','actorName','targetId','targetType','comment','read','createdAt']) && request.resource.data.actorId == request.auth.uid && request.resource.data.read == false && text(request.resource.data.title,200) && text(request.resource.data.message,3000) && validEvent());
        allow update: if isOwner(uid) && changedOnly(['read']) && request.resource.data.read is bool;
        allow delete: if isOwner(uid) || isAdmin();
      }
    }
    match /posts/{post} {
      allow get: if publicPost(resource.data) || isAdmin() || (isPublisher() && resource.data.authorId == request.auth.uid);
      // Public lists use the filtered read-only function, including legacy posts
      // without normalized visibility/releaseAt fields. No migration is required.
      allow list: if isAdmin() || (isPublisher() && resource.data.authorId == request.auth.uid);
      allow create: if isAdmin() || (isPublisher() && request.resource.data.authorId == request.auth.uid && request.resource.data.status in ['draft','pending']);
      allow update: if isAdmin() || (isPublisher() && resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId && resource.data.status in ['draft','pending'] && request.resource.data.status in ['draft','pending']);
      allow delete: if isAdmin() || (isPublisher() && resource.data.authorId == request.auth.uid);
    }
    match /sitePages/{page} { allow read: if isPublisher() || (resource.data.status == 'published' && resource.data.get('visibility','public') == 'public'); allow write: if isPublisher(); }
    match /siteSettings/{setting} { allow read: if setting == 'postCategories'; allow write: if isAdmin(); }
    match /siteConfig/{config} { allow read: if config == 'profileAchievements'; allow write: if isAdmin() && config != 'profileAchievements'; }
    match /profileIcons/{icon} { allow read: if true; allow write: if false; }
    match /communities/{community} {
      function ownMembershipCount() {
        let member=/databases/$(database)/documents/communities/$(community)/members/$(request.auth.uid);
        return isActive() && community != 'galaxia-oficial' && !resource.data.get('lockedMembership',false) && changedOnly(['membersCount','updatedAt'])
          && ((!exists(member) && existsAfter(member) && request.resource.data.membersCount == resource.data.get('membersCount',0)+1)
          || (exists(member) && !existsAfter(member) && request.resource.data.membersCount == (resource.data.get('membersCount',0)>0?resource.data.membersCount-1:0)));
      }
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || ownMembershipCount();
      match /members/{uid} {
        allow read: if true;
        allow create, update: if isAdmin() || (isOwner(uid) && isActive() && community != 'galaxia-oficial' && !get(/databases/$(database)/documents/communities/$(community)).data.get('lockedMembership',false)
          && request.resource.data.keys().hasOnly(['userId','uid','name','imageUrl','joinedAt','updatedAt']) && request.resource.data.get('userId',uid) == uid && request.resource.data.get('uid',uid) == uid);
        allow delete: if isAdmin() || (isOwner(uid) && community != 'galaxia-oficial');
      }
    }
    match /communityThreads/{thread} {
      function canPublish(data) { return isActive() && ((data.communityId == 'galaxia-oficial' && isPublisher()) || (data.communityId != 'galaxia-oficial' && exists(/databases/$(database)/documents/communities/$(data.communityId)/members/$(request.auth.uid)) && !get(/databases/$(database)/documents/communities/$(data.communityId)).data.get('adminOnlyThreads',false))); }
      allow read: if true;
      allow create: if canPublish(request.resource.data) && request.resource.data.authorId == request.auth.uid && request.resource.data.get('likes',0) == 0 && request.resource.data.get('likedBy',[]) == [] && request.resource.data.get('comments',[]) == [] && request.resource.data.get('replies',0) == 0 && !request.resource.data.get('pinnedCommunity',false) && !request.resource.data.get('pinnedHome',false) && !request.resource.data.get('showOnHome',false)
        && request.resource.data.get('isOfficial',false) == (request.resource.data.communityId == 'galaxia-oficial') && request.resource.data.get('lockedThread',false) == (request.resource.data.communityId == 'galaxia-oficial');
      allow update: if isAdmin() || (isPublisher() && changedOnly(['pinnedCommunity','pinnedAt','pinnedBy','pinnedHome','showOnHome','homePinnedAt','homePinnedBy','updatedAt'])) || (isActive() && (
        (changedOnly(['likedBy','likes','updatedAt']) && ownToggle(resource.data.get('likedBy',[]),request.resource.data.likedBy) && request.resource.data.likes == request.resource.data.likedBy.size())
        || (changedOnly(['comments','replies','updatedAt']) && ownReplyChange(resource.data.get('comments',[]),request.resource.data.comments) && request.resource.data.get('replies',request.resource.data.comments.size()) == request.resource.data.comments.size())
        || (isOwner(resource.data.authorId) && changedOnly(['title','body','topic','imageUrl','imageUrls','gif','spoiler','editedAt','updatedAt']) && canPublish(resource.data))));
      allow delete: if isAdmin() || (isActive() && isOwner(resource.data.authorId));
    }
    match /galaxyEvents/{event} {
      // Public function omits other people's reminder preferences and filters drafts.
      allow read: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isActive() && changedOnly(['notifyBy']) && ownToggle(resource.data.get('notifyBy',[]),request.resource.data.notifyBy));
    }
    match /liveGoals/{goal} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isActive() && resource.data.type != 'mission' && changedOnly(['likesBy','likerProfiles','updatedAt']) && ownMap('likesBy') && ownMap('likerProfiles') && request.resource.data.likesBy[request.auth.uid] == resource.data.get('likesBy',{}).get(request.auth.uid,0)+1);
    }
    match /liveChats/{live} {
      function validPreview() {
        let d=request.resource.data;
        let message=getAfter(/databases/$(database)/documents/liveChats/$(live)/messages/$(d.lastMessageId)).data;
        return chatAllowed() && resource.data.get('active',false) && changedOnly(['lastMessageId','lastMessagePreview','lastMessageAuthorId','updatedAt']) && message.authorId == request.auth.uid && message.body == d.lastMessagePreview && message.createdAt == request.time && d.lastMessageAuthorId == request.auth.uid;
      }
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || validPreview();
      match /messages/{message} {
        allow read: if true;
        allow create: if chatAllowed() && get(/databases/$(database)/documents/liveChats/$(live)).data.get('active',false) && request.resource.data.keys().hasOnly(['body','authorId','author','authorImage','createdAt']) && request.resource.data.authorId == request.auth.uid && text(request.resource.data.body,2000) && request.resource.data.body.size() > 0 && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
    match /videoChats/{video}/messages/{message} {
      allow read: if true;
      allow create: if isActive() && request.resource.data.authorId == request.auth.uid && request.resource.data.keys().hasOnly(['videoId','videoTitle','videoSecond','body','gif','authorId','author','authorImage','authorIconEffect','likedBy','likes','replies','kind','createdAt']) && text(request.resource.data.body,2000) && request.resource.data.get('likes',0) == 0 && request.resource.data.get('likedBy',[]) == [] && request.resource.data.get('replies',[]) == [];
      allow update: if isAdmin() || (isActive() && ((changedOnly(['likes','likedBy']) && ownToggle(resource.data.get('likedBy',[]),request.resource.data.likedBy) && request.resource.data.likes == request.resource.data.likedBy.size()) || (changedOnly(['replies']) && ownReplyChange(resource.data.get('replies',[]),request.resource.data.replies))));
      allow delete: if isAdmin() || (isActive() && isOwner(resource.data.authorId));
    }
    match /directChats/{chat} {
      function member() { return chatAllowed() && request.auth.uid in resource.data.participants; }
      function parentMember() { return chatAllowed() && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chat)).data.participants; }
      function validParticipants() { return request.resource.data.participants is list && request.resource.data.participants.size() == 2 && request.resource.data.participants.toSet().size() == 2 && request.auth.uid in request.resource.data.participants; }
      function validSend() {
        let d=request.resource.data;
        let path=/databases/$(database)/documents/directChats/$(chat)/messages/$(d.lastMessageId);
        let message=getAfter(path).data;
        return !exists(path) && message.authorId == request.auth.uid && message.createdAt == request.time && d.lastMessageAuthorId == request.auth.uid && d.updatedAt == request.time
          && d.get('lastMessagePreview',message.body) == (message.body == ''?'GIF':message.body)
          && d.get('lastMessage',message.body) == (message.body == ''?'GIF':message.body)
          && d.get('deletedFor',{}).keys().hasOnly(d.participants)
          && d.get('deletedFor',{}).get(d.participants[0],false) == false && d.get('deletedFor',{}).get(d.participants[1],false) == false;
      }
      allow get: if (exists(/databases/$(database)/documents/directChats/$(chat)) && member()) || (chatAllowed() && !exists(/databases/$(database)/documents/directChats/$(chat)) && chat.split('_').size() == 2 && request.auth.uid in chat.split('_'));
      allow list: if member();
      allow create: if chatAllowed() && validParticipants() && request.resource.data.keys().hasOnly(['participants','participantNames','updatedAt','lastMessage','lastMessageId','lastMessageAuthorId','lastMessagePreview','lastReadBy','deletedFor']) && validSend();
      allow update: if member() && validParticipants() && request.resource.data.participants.toSet() == resource.data.participants.toSet() && (
        (changedOnly(['participantNames','updatedAt','lastReadBy','hiddenBefore','deletedFor','pinnedBy','clearedAtBy']) && ownMap('lastReadBy') && ownMap('hiddenBefore') && ownMap('deletedFor') && ownMap('pinnedBy') && ownMap('clearedAtBy'))
        || (changedOnly(['participants','participantNames','updatedAt','lastMessage','lastMessageId','lastMessageAuthorId','lastMessagePreview','lastReadBy','deletedFor']) && ownMap('lastReadBy') && validSend()));
      allow delete: if false;
      match /messages/{message} {
        allow read: if parentMember() || (chatAllowed() && !exists(/databases/$(database)/documents/directChats/$(chat)) && chat.split('_').size() == 2 && request.auth.uid in chat.split('_'));
        allow create: if chatAllowed() && request.auth.uid in getAfter(/databases/$(database)/documents/directChats/$(chat)).data.participants && request.resource.data.authorId == request.auth.uid && request.resource.data.keys().hasOnly(['body','gif','authorId','author','authorName','createdAt','readBy','seenAt']) && text(request.resource.data.body,2000) && request.resource.data.createdAt == request.time && request.resource.data.get('readBy',{}).keys().hasOnly([request.auth.uid]) && request.resource.data.get('seenAt',{}).keys().hasOnly([request.auth.uid]);
        allow update: if parentMember() && changedOnly(['readBy','seenAt']) && ownMap('readBy') && ownMap('seenAt');
        allow delete: if false;
      }
    }
    match /overlays/{uid}/items/{scene} { allow get: if true; allow list, create, update, delete: if isAdmin() && isOwner(uid); }
    match /mailQueue/{message} { allow read, write: if isAdmin(); }
    match /ruzafaPrinterProducts/{product} { allow read: if true; allow write: if isAdmin(); }
    match /ruzafaPrinterHistory/{entry} { allow read, write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
