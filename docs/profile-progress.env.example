# Server-only template. Configure through Netlify's environment UI, Functions
# scope. Never put a real service-account JSON in this tracked file or VITE_*.
PROGRESS_ENABLED=false
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-bucket-name
FIREBASE_ADMIN_SERVICE_ACCOUNT=replace-with-private-service-account-json-in-netlify-only
# Optional explicit runtime override: set through Netlify UI, not netlify.toml.
AWS_LAMBDA_JS_RUNTIME=nodejs22.x
