# Public live/video configuration used by the frontend.
VITE_YOUTUBE_CHANNEL_ID=
VITE_YOUTUBE_HANDLE=
VITE_YOUTUBE_API_KEY=
VITE_TWITCH_CHANNEL=
VITE_TIKTOK_USER=
VITE_GIPHY_API_KEY=
VITE_PUBLIC_BUILDER_KEY=
VITE_SITE_URL=https://galaxianintendera.com

# Local realtime bridge for widgets/TikTok chat.
VITE_SOCKET_URL=http://localhost:3001

# Server-only IGDB/Twitch application credentials for Netlify functions.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Server-only OpenXBL key. Put the real value in .env.local (ignored by Git).
# Restart npm run dev after editing it. Never use a VITE_ prefix for this key.
OPENXBL_API_KEY=

# Firebase public web configuration (Builds and Functions scopes in Netlify).
# Vite exposes only these public fields; do not use service-account credentials here.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
# Optional overrides; defaults use the project ID and the current Firebase bucket domain.
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
